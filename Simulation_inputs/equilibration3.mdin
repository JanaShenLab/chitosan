A NPT simulation for restrained equilibration simulations
 &cntrl
    imin=0,         ! No minimization
    irest=1,        ! This IS a restart of an old MD simulation
    ntx=5,          ! So our inpcrd file has velocities

    ! Temperature control
    ntt=3,          ! Langevin dynamics
    gamma_ln=1.0,   ! Friction coefficient (ps^-1)
    temp0=323,      ! Target temperature

    ! Potential energy control
    cut=12.0,        ! Nonbonded cutoff, in Angstroms
    fswitch=10.0,

    ! MD settings
    nstlim=5000000, ! 2500K steps, 10 ns total
    dt=0.002,       ! time step (ps)

    ! SHAKE
    ntc=2,          ! Constrain bonds containing hydrogen
    ntf=2,          ! Do not calculate forces of bonds containing hydrogen

    ! Control how often information is printed
    ntpr=100000,    ! Print energies every 250k steps
    ntwx=50000,     ! Print coordinates every 25k steps to the trajectory
    ntwr=100000,   ! Print a restart file every 5000K steps (can be less frequent)
    ntxo=2,         ! Restart file format =1 ASCII, =2 NetCDF format
    ioutfm=1,       ! Trajectory file format =1 NetCDF format (always do this!), =2 ASCII

    ! Wrap coordinates when printing them to the same unit cell
    iwrap=0,        ! =0 wrap off, =1 wrap on

    ! Constant pressure control.
    ntp=1,          ! =1 isotropic, =2 anisotropic, =3 semi-isotropic w/ surften
    barostat=2,     ! Monte Carlo barostat, =1 Berenson
    ntb=2,          ! =2, Use constant pressure periodic boundary; =1 constant volumn
    pres0=1.0,      ! Target external pressure, in bar
    taup=1.0,       ! Pressure relaxation time (ps)

    ! Restrain the solute
    ntr=1,                       ! turn on restraint
    restraint_wt=1.0,             ! harmonic restraints (10 kcal/molA²)
    restraintmask=':1-5592&!@H=', ! protein heavy atoms
 /

                                                                                                                            45,0-1        Bot


